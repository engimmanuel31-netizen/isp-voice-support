# Copy this file to .env for local runs. On Render, add the same names under Environment.

# Required: free Gemini API key from https://aistudio.google.com (server only, never put it in the browser)
GEMINI_API_KEY=your-gemini-key-here

# Required: PIN the technician types on /tech
TECH_PIN=4821

# Branding
ISP_NAME=NetConnect
ASSISTANT_NAME=Asha

# Voice AI model and voice (change if Google renames models)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore

# Call limits
MAX_CALL_SECONDS=600
RING_TIMEOUT_SECONDS=45
SESSIONS_PER_HOUR_PER_IP=20

# Optional TURN relay for mobile data / strict networks (free tier: metered.ca or Cloudflare)
# Comma-separate several URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
